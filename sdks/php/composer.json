{
    "name": "lcp/php-sdk",
    "description": "LCP PHP SDK persistent storage layer (SQLite backend) aligned to LCP v1.0.0.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Lcp\\Php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lcp\\Php\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
